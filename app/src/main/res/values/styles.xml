<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--Стили для кнопок -->

    <!--Базовая кнопка -->
    <style name="Button.Base" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">45dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!--Primary Button (заполненная градиентом) -->
    <style name="Button.Primary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!--Secondary Button (кнопка с обводкой) -->
    <style name="Button.Secondary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_primary_gradient_start</item>
        <item name="strokeColor">@color/button_primary_gradient_start</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!--Text Button (просто текст) -->
    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/button_primary_gradient_start</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!--Стили для магазина расширений -->

    <!--Стиль для кнопок в ToggleGroup (сортировка) -->
    <style name="ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/toggle_button_text_selector</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!--Стиль для чипов фильтрации -->
    <style name="Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconTint">@color/button_primary_gradient_end</item>
        <item name="chipStrokeColor">@color/button_primary_gradient_end</item>
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">32dp</item>
    </style>

    <!--Информационный чип (для карточек расширений) -->
    <style name="Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipStrokeColor">@color/button_primary_gradient_end</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/button_primary_gradient_end</item>
        <item name="android:textSize">10sp</item>
        <item name="chipIconTint">@color/button_primary_gradient_end</item>
        <item name="android:minHeight">24dp</item>
    </style>

</resources>