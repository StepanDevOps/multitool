<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--Стили для кнопок -->

    <!--Базовая кнопка -->
    <style name="Button.Base" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">45dp</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!--Primary Button (заполненная градиентом) -->
    <style name="Button.Primary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!--Secondary Button (кнопка с обводкой) -->
    <style name="Button.Secondary" parent="Button.Base">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_primary_gradient_start</item>
        <item name="strokeColor">@color/button_primary_gradient_start</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!--Text Button (просто текст) -->
    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/button_primary_gradient_start</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>